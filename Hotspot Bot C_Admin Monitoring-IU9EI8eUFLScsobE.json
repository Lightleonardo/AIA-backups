      },
      "id": "3dabad1b-2089-4bd2-b81a-58303430b743",
      "name": "Run Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
