        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "233e6e82-9b98-48ac-b094-dde26d856bb7",
      "name": "Check MikroTik Voucher Pool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "voucher_count",
              "name": "voucher_count",
              "value": "={{ $input.all().length }}",
              "type": "number"
            },
            {
              "id": "checked_at",
              "name": "checked_at",
              "value": "={{ $now.toFormat(\"dd MMM yyyy, HH:mm\") }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d77af7da-fc1c-4a85-9735-a724ef662b39",
      "name": "Count Active Vouchers",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        448,
        96
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.voucher_count }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              },
              "rightValue": 10,
              "id": "b64f1699-3bcf-4369-94bb-fec764547404"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8dafad4c-ef04-472a-bab4-0e0a6a330aa3",
      "name": "Is Voucher Pool Low?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "<__PLACEHOLDER_VALUE__Discord Webhook URL for admin alerts__>",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"content\": \"⚠️ **Low Voucher Alert**\\n\\nOnly **\" + $(\"Count Active Vouchers\").item.json.voucher_count + \" vouchers** remaining in the MikroTik pool.\\nPlease generate more vouchers to avoid service interruption.\\n\\nChecked at: \" + $(\"Count Active Vouchers\").item.json.checked_at } }}",
        "options": {}
      },
      "id": "b7aae5d0-a193-4804-807f-2173b84fce6b",
