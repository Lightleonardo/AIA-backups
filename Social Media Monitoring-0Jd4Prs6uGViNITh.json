    {
      "parameters": {
        "jsCode": "const negativeWords = [\n  \"scam\",\n  \"bad\",\n  \"fraud\",\n  \"issue\",\n  \"broken\",\n  \"terrible\",\n  \"hate\",\n  \"worst\",\n  \"problem\",\n  \"fake\"\n];\n\nconst positiveWords = [\n  \"amazing\",\n  \"great\",\n  \"excellent\",\n  \"love\",\n  \"best\",\n  \"awesome\",\n  \"good\",\n  \"fantastic\",\n  \"successful\",\n  \"impressive\"\n];\n\nreturn items.map(item => {\n\n  const text = `\n    ${item.json.title || \"\"}\n    ${item.json.snippet || \"\"}\n  `.toLowerCase();\n\n  let sentiment = \"neutral\";\n\n  if (negativeWords.some(word => text.includes(word))) {\n    sentiment = \"negative\";\n  } else if (positiveWords.some(word => text.includes(word))) {\n    sentiment = \"positive\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      sentiment\n    }\n  };\n});"
      },
