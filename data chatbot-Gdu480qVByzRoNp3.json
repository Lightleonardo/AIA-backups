      ],
      "id": "012e4523-5372-449e-8c95-cd16c37781b6",
      "name": "HTTP Fallback Tool"
    },
    {
      "parameters": {
        "jsCode": "// Get AI output\nconst aiOutput = $json.output;\n\n// Get session info\nconst sessionId = $('Extract Fields').first().json.sessionId;\nlet sessionTitle;\n\n// Try to get title from existing session or newly generated\ntry {\n  sessionTitle = $('Extract Existing Session').first().json.sessionTitle ||\n                 $('Parse Title').first().json.sessionTitle ||\n                 'Untitled Session';\n} catch (e) {\n  sessionTitle = 'Untitled Session';\n}\n\n// Parse AI output as JSON\nlet parsedResponse;\ntry {\n  // Remove markdown code blocks if present\n  const cleaned = aiOutput.replace(/```json\\n?|```/g, '').trim();\n  parsedResponse = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback if parsing fails\n  parsedResponse = {\n    assistant_reply: aiOutput,\n    columns: [],\n    rows: [],\n    confidence: 50,\n    sources: []\n  };\n}\n\n// Ensure all required fields exist\nconst finalResponse = {\n  session_id: sessionId,\n  session_title: sessionTitle,\n  assistant_reply: parsedResponse.assistant_reply || aiOutput,\n  columns: parsedResponse.columns || [],\n  rows: parsedResponse.rows || [],\n  confidence: parsedResponse.confidence || 50,\n  sources: parsedResponse.sources || []\n};\n\nreturn [{ json: finalResponse }];"
      },
