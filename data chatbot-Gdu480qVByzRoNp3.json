    {
      "parameters": {
        "toolDescription": "Fallback data source when Pinecone retrieval fails (confidence <= 40). Sends POST request with client_id, question, and erp_file_url. Only use after exhausting Pinecone retries.",
        "method": "POST",
        "url": "https://divverse-community.app.n8n.cloud/webhook/data-insight-on-demand",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"client_id\": $fromAI('client_id', '', 'string'),\n  \"question\": $fromAI('question', '', 'string'),\n  \"erp_file_url\": \"https://drive.google.com/file/d/1VueVVW7jz2lW5dsqnxedsK0cJ1__p2jf/view?usp=drive_link\"\n} }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "position": [
