    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a short, concise session title (3-6 words max) from this user query:\n\n\"{{ $('Extract Fields').first().json.chatInput }}\"\n\n",
        "messages": {
          "messageValues": [
            {
              "message": "=Generate a short session title from the user query. Return only JSON with a 'title' field.\n\nRules:\n- Natural language title\n- No labels like \"Session Title:\"\n- No quotation marks\n- No explanations\n- 3-6 words maximum\n\nReturn ONLY valid JSON:\n{\n  \"title\": \"Your Title Here\"\n}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        -80,
        400
      ],
      "id": "4a2ef3f3-c9df-4a3a-88c4-895f203a1ba8",
      "name": "Generate Session Title"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.text;\nlet title;\n\ntry {\n  const cleaned = raw.replace(/```json\\n?|```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  title = parsed.title || 'Untitled Session';\n} catch (e) {\n  title = raw.slice(0, 50) || 'Untitled Session';\n}\n\nreturn [{\n  json: {\n    sessionTitle: title,\n    sessionId: $('Extract Fields').first().json.sessionId\n  }\n}];"
      },
